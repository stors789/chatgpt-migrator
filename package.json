{
  "name": "@stors789/chatport",
  "version": "0.2.2",
  "description": "Chrome extension to select, migrate, and verify ChatGPT conversations between personal accounts.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "check": "node scripts/check.js",
    "format": "prettier --write src public test scripts \"*.md\" \"*.json\" .github .impeccable/surfaces .impeccable/config.json",
    "browser:install": "playwright install chromium",
    "build": "node scripts/build.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stors789/chatgpt-migrator.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "chatgpt",
    "migration",
    "share-links",
    "playwright",
    "chat-history"
  ],
  "devDependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "prettier": "3.9.10",
    "playwright": "1.64.0"
  }
}
