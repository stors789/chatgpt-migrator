{
  "manifest_version": 3,
  "name": "ChatPort — ChatGPT conversation migration",
  "version": "0.2.4",
  "description": "Select chats, copy them between your personal ChatGPT accounts, and verify the saved text. Runs inside Chrome.",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "incognito": "spanning",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open ChatPort",
    "default_icon": {
      "16": "public/icons/16.png",
      "32": "public/icons/32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'; base-uri 'none'"
  },
  "key": "",
  "icons": {
    "16": "public/icons/16.png",
    "32": "public/icons/32.png",
    "48": "public/icons/48.png",
    "128": "public/icons/128.png"
  }
}
